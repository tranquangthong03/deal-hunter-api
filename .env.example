# ===== App =====
APP_NAME=Deal Hunter API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-please-32-chars-min

# ===== Database =====
POSTGRES_USER=dealhunter
POSTGRES_PASSWORD=dealhunter_pass
POSTGRES_DB=dealhunter_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dealhunter:dealhunter_pass@postgres:5432/dealhunter_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ===== Redis =====
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# ===== Celery =====
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Scraper (Apify) =====
APIFY_API_TOKEN=
APIFY_TIKI_ACTOR_ID=

# ===== Business Logic =====
CRAWL_INTERVAL_HOURS=6
DEAL_THRESHOLD_PERCENT=15
PRICE_HISTORY_LOOKBACK_DAYS=7